{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClaimsDatabase": "",
    "AuditDatabase": ""
  },
  "MongoDb": {
    "DatabaseName": "Claims"
  },
  "AuditDatabase": {
    "ApplyMigrationsOnStartup": true
  },
  "Outbox": {
    "PollingInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 10,
    "MaxRetryDelay": "00:05:00",
    "LockDuration": "00:00:30",
    "ProcessedRetention": "7.00:00:00"
  },
  "Messaging": {
    "Transport": "InProcess",
    "AzureServiceBus": {
      "ConnectionString": "",
      "FullyQualifiedNamespace": "",
      "QueueName": "claims-domain-events",
      "MaxConcurrentCalls": 4
    }
  },
  "ApiDocumentation": {
    "Enabled": true
  },
  "LocalContainers": {
    "Enabled": false
  }
}
